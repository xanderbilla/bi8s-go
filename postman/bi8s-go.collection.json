{
  "info": {
    "_postman_id": "f4b0870c-a801-4b5b-a312-38a5d4af8d77",
    "name": "bi8s-go API",
    "description": "Complete Postman collection for bi8s-go API.\n\n**Environments (set `{{baseUrl}}` to one of):**\n- `prod`  → https://api.emm4bi8s.dev/v1\n- `dev`   → https://api-dev.emm4bi8s.dev/v1\n- `local` → http://localhost:8080/v1\n\n**Body format:** CREATE endpoints and asset upload endpoints use `multipart/form-data`.\n\n**EntityRef format** for relationship fields (`genres`, `casts`, `tags`, etc.): comma-separated `id:name` pairs, e.g. `genre-action:Action,genre-drama:Drama`.\n\nAll responses use the standard envelope with `success`, `status`, `message`, `data`, `error`, `path`, `requestId`, `timestamp`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/v1",
      "description": "Active base URL. Switch to https://api.emm4bi8s.dev/v1 (prod) or https://api-dev.emm4bi8s.dev/v1 (dev).",
      "type": "string"
    },
    {
      "key": "baseUrl_prod",
      "value": "https://api.emm4bi8s.dev/v1",
      "type": "string"
    },
    {
      "key": "baseUrl_dev",
      "value": "https://api-dev.emm4bi8s.dev/v1",
      "type": "string"
    },
    {
      "key": "baseUrl_local",
      "value": "http://localhost:8080/v1",
      "type": "string"
    },
    {
      "key": "contentId",
      "value": "tt0111161",
      "description": "Sample content ID (alphanumeric + -_, max 100 chars).",
      "type": "string"
    },
    {

                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)."
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "DynamoDB pagination cursor (base64). Empty for first page."
                }
              ]
            },
            "description": "Paginated minimal list of content featuring the specified person.\n\n**Path param `peopleId`:** alphanumeric + `-_`, max 100 chars.\n\nReturns lightweight items: `{id, title, backdropPath}`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Consumer — Attributes",
      "description": "Public attribute listing (genres, tags, moods, studios, categories, specialities). Results cached in memory for 10 minutes.",
      "item": [
        {
          "name": "List Consumer Attributes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/attributes?type=GENRE&sort=alpha_asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "attributes"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "GENRE",
                  "description": "Filter by attribute type. Allowed: `GENRE`, `TAG`, `MOOD`, `STUDIO`, `CATEGORY`, `SPECIALITY` (case-insensitive, plurals accepted e.g. `genres`). Omit for all active attributes."
                },
                {
                  "key": "sort",
                  "value": "alpha_asc",
                  "description": "Alphabetical sort order. Allowed: `alpha_asc`, `alpha_desc`. Omit for default insertion order."
                }
              ]
            },
            "description": "Returns all active attributes visible to consumers, optionally filtered by type and sorted alphabetically.\n\n**`type` allowed values:** `GENRE` | `TAG` | `MOOD` | `STUDIO` | `CATEGORY` | `SPECIALITY`\n\n**Response per item:** id, name, attributeType[], contentType, active."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — Content",
      "description": "Admin CRUD and asset-management endpoints for content. Require internal/admin network access.",
      "item": [
        {
          "name": "List All Content (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/a/content/?limit=20&cursor=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a",
                "content",
                ""
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)."
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "DynamoDB pagination cursor (base64). Empty for first page."
                }
              ]
            },
            "description": "Returns a paginated list of ALL content including private items, with full `Movie` objects and audit fields (`createdAt`, `updatedAt`)."
          },
          "response": []
        },
        {
          "name": "Get Content by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/a/content/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a",
                "content",
                "{{contentId}}"
              ]
            },
            "description": "Fetch full admin detail for a single content item including internal fields (audit, visibility, stats).\n\n**Path param `contentId`:** alphanumeric + `-_`, max 100 chars."
          },
          "response": []
        },
        {
          "name": "Create Content (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "id",
                  "value": "tt0111161",
                  "description": "Optional custom ID (alphanumeric + -_, 1–64 chars). Omit to auto-generate a UUID.",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "The Shawshank Redemption",
                  "description": "Content title (1–128 chars).",
                  "type": "text"
                },
                {
                  "key": "overview",
                  "value": "Two imprisoned men bond over a number of years, finding solace and eventual redemption through acts of common decency.",
                  "description": "REQUIRED. Synopsis / description (1–150 chars, auto-clamped to 150).",
                  "type": "text"
                },
                {
                  "key": "content_type",
                  "value": "MOVIE",
                  "description": "Content type. Allowed: `MOVIE`, `TV`.",
                  "type": "text"
                },
                {
                  "key": "original_language",
                  "value": "en",
                  "description": "REQUIRED. ISO 639-1 code. Allowed: `en`, `hi`, `ja`, `ko`, `fr`, `es`.",
                  "type": "text"
                },
                {
                  "key": "content_rating",
                  "value": "18_PLUS",
                  "description": "Age rating. Allowed: `18_PLUS`, `21_PLUS`.",
                  "type": "text"
                },
                {
                  "key": "release_date",
                  "value": "1994-09-23",
                  "description": "Release date in YYYY-MM-DD format (use for MOVIE).",
                  "type": "text"
                },
                {
                  "key": "first_air_date",
                  "value": "",
                  "description": "First air date in YYYY-MM-DD format (use for TV). Mutually exclusive with release_date.",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "runtime",
                  "value": "142",
                  "description": "Runtime in minutes (integer ≥ 0).",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "RELEASED",
                  "description": "Production status. Allowed: `RUMORED`, `PLANNED`, `IN_PRODUCTION`, `POST_PRODUCTION`, `RELEASED`, `ENDED`, `RETURNING_SERIES`, `CANCELED`, `PILOT`.",
                  "type": "text"
                },
                {
                  "key": "tagline",
                  "value": "Fear can hold you prisoner. Hope can set you free.",
                  "description": "Tagline (max 255 chars).",
                  "type": "text"
                },
                {
                  "key": "visibility",
                  "value": "PUBLIC",
                  "description": "Visibility. Allowed: `PUBLIC`, `PRIVATE`.",
                  "type": "text"
                },
                {
                  "key": "adult",
                  "value": "true",
                  "description": "Adult content flag. Allowed: `true`, `false`.",
                  "type": "text"
                },
                {
                  "key": "origin_country",
                  "value": "US",
                  "description": "Comma-separated ISO country codes (e.g. `US,JP`). Each code 2–8 chars.",
                  "type": "text"
                },
                {
                  "key": "genres",
                  "value": "genre-drama:Drama,genre-crime:Crime",
                  "description": "Comma-separated `id:name` pairs for genre attribute refs (e.g. `genre-action:Action,genre-drama:Drama`). The `:name` suffix is optional.",
                  "type": "text"
                },
                {
                  "key": "casts",
                  "value": "person-001:Tim Robbins,person-002:Morgan Freeman",
                  "description": "Comma-separated `id:name` pairs for cast person refs.",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "tag-prison:Prison,tag-hope:Hope",
                  "description": "Comma-separated `id:name` pairs for tag attribute refs.",
                  "type": "text"
                },
                {
                  "key": "mood_tags",
                  "value": "mood-inspiring:Inspiring",
                  "description": "Comma-separated `id:name` pairs for mood attribute refs.",
                  "type": "text"
                },
                {
                  "key": "studios",
                  "value": "studio-castle:Castle Rock Entertainment",
                  "description": "Comma-separated `id:name` pairs for studio attribute refs.",
                  "type": "text"
                },
                {
                  "key": "poster",
                  "value": null,
                  "description": "Poster image file upload (JPEG/PNG, optional).",
                  "type": "file"
                },
                {
                  "key": "cover",
                  "value": null,
                  "description": "Cover/backdrop image file upload (JPEG/PNG, optional).",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/a/content/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a",
                "content",
                ""
              ]
            },
            "description": "Create a new content item. Body **must** be `multipart/form-data`.\n\n**Required fields:** `overview`, `original_language`\n\n**EntityRef format** (`genres`, `casts`, `tags`, `mood_tags`, `studios`): `id:name,id2:name2` — the `:name` part is optional but recommended.\n\n**File fields:** `poster` (portrait poster), `cover` (landscape backdrop)\n\nReturns `201 Created` with the full `Movie` object."
          },
          "response": []
        },
        {
          "name": "Delete Content (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/a/content/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "a",
                "content",
                "{{contentId}}"
              ]
            },
            "description": "Permanently delete a content item by ID.\n\n**Path param `contentId`:** alphanumeric + `-_`, max 100 chars.\n\nReturns `200` with `{data: null}` on success, `404` if not found."
          },
          "response": []
        },

  "item": [
    {
      "name": "System",
      "description": "Health, liveness, readiness probes and API documentation endpoints. All unauthenticated.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Full health check. Runs concurrent checks against DynamoDB, OpenSearch, Redis, S3/B2, ffmpeg, ffprobe (2 s timeout each).\n\nReturns `200` with `{checks: {dep: \"up\"|\"down\"}, version, commit, built}`, or `503 SERVICE_UNAVAILABLE` if any dependency is down."
          },
          "response": []
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livez",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livez"
              ]
            },
            "description": "Kubernetes liveness probe. Always returns `200` with `{version}` if the process is alive. No dependency checks performed."
          },
          "response": []
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "Kubernetes readiness probe. Returns `503 NOT_READY` until application bootstrap completes. After that behaves identically to `GET /health` — runs all dependency checks."
          },
          "response": []
        },
        {
          "name": "OpenAPI Spec (YAML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.yaml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.yaml"
              ]
            },
            "description": "Returns the raw OpenAPI 3.x specification in YAML format. Served from the embedded `docs/OPENAPI.yaml`."
          },
          "response": []
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs"
              ]
            },
            "description": "Serves the embedded Swagger UI HTML page backed by `/v1/openapi.yaml`. Open in a browser for interactive API exploration."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Consumer — Search",
      "description": "Full-text and semantic search powered by OpenSearch. No auth required.",
      "item": [
        {
          "name": "Search Content & People",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/search?query=action&in=content&page=1&pageSize=20&contentPage=1&contentPageSize=20&peoplePage=1&peoplePageSize=20&sort=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "action",
                  "description": "REQUIRED. Search term (non-empty string)."
                },
                {
                  "key": "in",
                  "value": "content",
                  "description": "Scope filter. Allowed: `content`, `people`. Omit to search both simultaneously."
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Global page number fallback for both content and people (default: 1)."
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "Global page size fallback (default: 20, max: 100)."
                },
                {
                  "key": "contentPage",
                  "value": "1",
                  "description": "Page number for the content results slice. Overrides `page`."
                },
                {
                  "key": "contentPageSize",
                  "value": "20",
                  "description": "Page size for content results. Overrides `pageSize`. Max: 100."
                },
                {
                  "key": "peoplePage",
                  "value": "1",
                  "description": "Page number for the people results slice. Overrides `page`."
                },
                {
                  "key": "peoplePageSize",
                  "value": "20",
                  "description": "Page size for people results. Overrides `pageSize`. Max: 100."
                },
                {
                  "key": "sort",
                  "value": "",
                  "description": "Sort mode (e.g. `relevance`). See search service docs for allowed values.",
                  "disabled": true
                }
              ]
            },
            "description": "Full-text search across content and/or people using OpenSearch.\n\n**Required:** `query`\n\n**`in` values:** `content` | `people` (omit for both)\n\n**Pagination** is per-result-type: use independent `contentPage`/`contentPageSize` and `peoplePage`/`peoplePageSize`, or fall back to the shared `page`/`pageSize`."
          },
          "response": []
        },
        {
          "name": "Related Content (More Like This)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/content/{{contentId}}/related?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "content",
                "{{contentId}}",
                "related"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)."
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "Number of results per page (default: 20, max: 100)."
                }
              ]
            },
            "description": "OpenSearch More-Like-This query — returns content similar to the specified item.\n\n**Path param `contentId`:** alphanumeric + `-_`, max 100 chars."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Consumer — Content",
      "description": "Public-facing content endpoints under `/v1/c/`. No auth required.",
      "item": [
        {
          "name": "Get Content by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/content/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "content",
                "{{contentId}}"
              ]
            },
            "description": "Fetch full public detail for a single content item (movie or TV show).\n\n**Path param `contentId`:** alphanumeric + `-_`, max 100 chars.\n\n**Response fields include:** id, title, overview, backdropPath, posterPath, releaseDate, firstAirDate, adult, contentRating, originalLanguage, genres, casts, tags, moodTags, studios, contentType, originCountry, runtime, status, tagline, assets, stats."
          },
          "response": []
        },
        {
          "name": "Get Banner Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/banner?type=movie",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "banner"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "movie",
                  "description": "Filter by content type. Allowed: `movie`, `tv`. Omit for no filter."
                }
              ]
            },
            "description": "Returns a single randomly selected featured/banner content item for the hero carousel.\n\n**`type`:** `movie` | `tv` (optional)"
          },
          "response": []
        },
        {
          "name": "Discover Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/discover?type=latest&content=movie&limit=20&cursor=&sort=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "discover"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "latest",
                  "description": "Discover category. Allowed: `latest` (default), `popular`."
                },
                {
                  "key": "content",
                  "value": "movie",
                  "description": "Filter by content type. Allowed: `movie`, `tv`. Omit for all."
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)."
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "DynamoDB pagination cursor (base64 encoded). Empty for first page. NOTE: when `sort` is set, this becomes a numeric offset string instead."
                },
                {
                  "key": "sort",
                  "value": "",
                  "description": "Alphabetical sort. Allowed: `alpha_asc`, `alpha_desc`. When set, switches from DynamoDB key pagination to full-scan offset pagination.",
                  "disabled": true
                }
              ]
            },
            "description": "Paginated discovery feed. Results are in-memory cached for 2 minutes.\n\n**`type`:** `latest` | `popular`\n\n**Pagination modes:**\n- Default: DynamoDB key-cursor pagination\n- When `sort` is set (`alpha_asc` / `alpha_desc`): full alphabetical scan with numeric offset cursor"
          },
          "response": []
        },
        {
          "name": "Get Content by Attribute ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/attributes/{{attributeId}}?content=movie&limit=20&cursor=&sort=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "attributes",
                "{{attributeId}}"
              ],
              "query": [
                {
                  "key": "content",
                  "value": "movie",
                  "description": "Filter by content type. Allowed: `movie`, `tv`. Omit for all."
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)."
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "DynamoDB pagination cursor (base64). Empty for first page. Becomes numeric offset when `sort` is active."
                },
                {
                  "key": "sort",
                  "value": "",
                  "description": "Alphabetical sort. Allowed: `alpha_asc`, `alpha_desc`. Switches pagination to full-scan offset mode.",
                  "disabled": true
                }
              ]
            },
            "description": "Fetch a paginated list of content associated with a specific attribute (e.g. a genre, tag, or mood).\n\n**Path param `id`:** alphanumeric + `-_`, max 100 chars."
          },
          "response": []
        },
        {
          "name": "Get Playback Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/c/play/movie/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "c",
                "play",
                "movie",
                "{{contentId}}"
              ]
            },
            "description": "Returns HLS playback URLs and quality manifest for the given content item.\n\n**Path param `contentType`:** `movie` | `tv` (lowercase, validated)\n\n**Path param `contentId`:** alphanumeric + `-_`, max 100 chars.\n\n**Response includes:** master playlist URL, per-quality video tracks, audio tracks, subtitle tracks, thumbnails, preview clip, and sprite sheet."
          },
          "response": []
        }
      ]
    },
